# ==============================================================================
# VINUTHA BAKERY - ENVIRONMENT VARIABLES CONFIGURATION
# Copy this file to .env or .env.local for local and production deployment
# ==============================================================================

# Application Environment
VITE_APP_ENV=production
VITE_APP_NAME="Vinutha Bakery"
VITE_APP_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (POSTGRESQL DATABASE, AUTH & STORAGE)
# ------------------------------------------------------------------------------
# In your Supabase Project Settings > API:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key

# Service Role Key (Keep strictly server-side / secret, NEVER expose to browser)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Storage Bucket Names configured in Supabase:
VITE_STORAGE_BUCKET_CAKES=cake-photos
VITE_STORAGE_BUCKET_UPLOADS=customer-uploads
VITE_STORAGE_BUCKET_INVOICES=supplier-invoices

# ------------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS (WHATSAPP BUSINESS & SMS NOTIFICATIONS)
# ------------------------------------------------------------------------------
# WhatsApp Cloud API credentials (Meta for Developers):
VITE_WHATSAPP_PHONE_NUMBER_ID=
VITE_WHATSAPP_ACCESS_TOKEN=

# Shop 1 Counter Phone & WhatsApp
VITE_SHOP1_PHONE=+919845012345
VITE_SHOP1_WHATSAPP=+919845012345

# Shop 2 Counter Phone & WhatsApp
VITE_SHOP2_PHONE=+919845067890
VITE_SHOP2_WHATSAPP=+919845067890
